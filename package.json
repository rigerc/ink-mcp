{
  "name": "ink-dev-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for developing and testing Ink terminal applications",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run typecheck",
    "build": "vp build",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vp test",
    "test:ci": "vp test run --reporter=json --outputFile=test-results.json",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint src/ scripts/",
    "lint:fix": "vp lint src/ scripts/ --fix",
    "format": "vp fmt \"src/**/*.ts\" \"scripts/**/*.mts\"",
    "format:check": "vp fmt --check \"src/**/*.ts\" \"scripts/**/*.mts\"",
    "verify:skill-package": "node scripts/verify-skill-package.mts",
    "test:smoke": "npm run build && node scripts/smoke-stdio.mts"
  },
  "keywords": [
    "mcp",
    "ink",
    "cli",
    "terminal",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-changelog-writer": "^9.3.0",
    "semantic-release": "^25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "effect": "^4.0.3",
    "yaml": "^2.9.1",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "conventional-changelog-writer": "$conventional-changelog-writer",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "bin": {
    "ink-dev-mcp": "dist/index.js"
  }
}
